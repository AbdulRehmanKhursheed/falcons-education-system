// Falcons Education System — portal database schema.
// Covers: users + roles, students + guardians, admissions pipeline, classrooms +
// enrollments, attendance, fees + invoices + payments, assessments, announcements,
// homework, notifications. Soft delete on key entities. All timestamps in UTC.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  PARENT
  ACCOUNTANT
}

enum ProgramKind {
  NURSERY
  MONTESSORI
  KINDERGARTEN
  PRIMARY        // Class 1–6
  EVENING_COACHING
  SATURDAY_COACHING
  COMPUTER_COURSE
}

enum StudentStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
  GRADUATED
}

enum ApplicationStage {
  RECEIVED
  INTERVIEW
  APPROVED
  ENROLLED
  DECLINED
  WITHDRAWN
}

enum ApplicationSource {
  WEBSITE
  WHATSAPP
  PHONE
  WALK_IN
  REFERRAL
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  SICK
  EXCUSED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  JAZZCASH
  EASYPAISA
  CHEQUE
  OTHER
}

enum AssessmentKind {
  MONTESSORI_OBSERVATION
  PRIMARY_GRADE
  PROGRESS_NOTE
}

enum AnnouncementAudience {
  ALL
  STAFF_ONLY
  PARENTS_ONLY
  CLASSROOM
  CUSTOM
}

enum NotificationKind {
  ADMISSION
  FEE
  ATTENDANCE
  ASSESSMENT
  ANNOUNCEMENT
  SYSTEM
}

// ── Users & auth ───────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?    // null = OAuth-only
  name          String
  phone         String?
  role          Role      @default(SCHOOL_ADMIN)
  avatarUrl     String?
  active        Boolean   @default(true)

  // Relations
  teacher         Teacher?
  guardian        Guardian?
  accounts        Account[]
  sessions        Session[]
  attendanceMarks Attendance[]   @relation("MarkedByUser")
  assessmentsBy   Assessment[]   @relation("AssessedByUser")
  announcementsBy Announcement[] @relation("PostedByUser")
  homework        Homework[]     @relation("HomeworkPostedBy")
  notifications   Notification[]
  paymentsRecorded Payment[]     @relation("RecordedByUser")
  auditLogs       AuditLog[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([role, active])
  @@index([deletedAt])
}

// NextAuth.js session tables — full set for the @auth/prisma-adapter.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Students & guardians ───────────────────────────────────────────────────

model Student {
  id              String        @id @default(cuid())
  rollNo          String        @unique
  firstName       String
  lastName        String
  fullName        String        // denormalized for search performance
  dateOfBirth     DateTime
  gender          String?       // 'female' | 'male' | other (free-text for cultural fit)
  bloodGroup      String?
  status          StudentStatus @default(ACTIVE)
  photoUrl        String?
  admissionDate   DateTime?
  notes           String?       // medical, allergies, etc — free-text, encrypted in Phase 2

  // Relations
  guardians       StudentGuardian[]
  enrollments     Enrollment[]
  attendance      Attendance[]
  invoices        Invoice[]
  assessments     Assessment[]
  applications    Application[]    // historical applications that became this student

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status, deletedAt])
  @@index([fullName])
}

model Guardian {
  id          String   @id @default(cuid())
  userId      String?  @unique   // optional — guardian gets a user account for the parent portal
  user        User?    @relation(fields: [userId], references: [id])

  fullName    String
  relation    String              // 'Father' | 'Mother' | 'Guardian'
  phone       String
  whatsapp    String?
  email       String?
  occupation  String?
  cnic        String?             // Pakistani national ID — sensitive
  address     String?
  isPrimary   Boolean  @default(false)

  students    StudentGuardian[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([phone])
  @@index([deletedAt])
}

// Join table — supports multiple guardians per student and sibling families.
model StudentGuardian {
  studentId  String
  guardianId String
  student    Student  @relation(fields: [studentId], references: [id])
  guardian   Guardian @relation(fields: [guardianId], references: [id])
  isPrimary  Boolean  @default(false)

  @@id([studentId, guardianId])
  @@index([guardianId])
}

// ── Admissions pipeline ────────────────────────────────────────────────────

model Application {
  id              String              @id @default(cuid())
  applicantName   String
  dateOfBirth     DateTime?
  childAge        String              // free-text, parents often write "3 years 2 months"
  programInterest ProgramKind
  parentName      String
  parentPhone     String
  parentEmail     String?
  notes           String?
  source          ApplicationSource   @default(WEBSITE)
  stage           ApplicationStage    @default(RECEIVED)

  // Once enrolled, link to the created Student
  studentId       String?
  student         Student?            @relation(fields: [studentId], references: [id])

  // Interview tracking
  interviewAt     DateTime?
  interviewNotes  String?

  // Documents (uploaded URLs)
  documents       Document[]

  submittedAt     DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([stage, submittedAt])
  @@index([parentPhone])
}

model Document {
  id            String   @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])
  label         String
  url           String
  mimeType      String?
  sizeBytes     Int?

  uploadedAt    DateTime @default(now())

  @@index([applicationId])
}

// ── Academic structure ─────────────────────────────────────────────────────

model AcademicYear {
  id        String   @id @default(cuid())
  name      String   @unique           // '2026-27'
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)

  classrooms Classroom[]

  createdAt DateTime @default(now())
}

model Classroom {
  id            String       @id @default(cuid())
  academicYearId String
  academicYear  AcademicYear @relation(fields: [academicYearId], references: [id])

  name          String                  // 'Class 3', 'Montessori A'
  programKind   ProgramKind
  homeroomTeacherId String?
  homeroomTeacher Teacher? @relation("HomeroomTeacher", fields: [homeroomTeacherId], references: [id])

  enrollments   Enrollment[]
  attendance    Attendance[]
  feeStructures FeeStructure[]
  homework      Homework[]
  announcements Announcement[]   @relation("ClassroomAnnouncements")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([academicYearId, name])
  @@index([academicYearId, programKind])
}

model Enrollment {
  id          String    @id @default(cuid())
  studentId   String
  classroomId String
  student     Student   @relation(fields: [studentId], references: [id])
  classroom   Classroom @relation(fields: [classroomId], references: [id])

  enrolledAt  DateTime  @default(now())
  withdrawnAt DateTime?

  @@unique([studentId, classroomId])
  @@index([classroomId])
}

// ── Teachers ───────────────────────────────────────────────────────────────

model Teacher {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])

  qualification String?
  joinedAt      DateTime?
  isActive      Boolean  @default(true)

  homerooms     Classroom[]  @relation("HomeroomTeacher")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// ── Attendance ─────────────────────────────────────────────────────────────

model Attendance {
  id          String           @id @default(cuid())
  studentId   String
  classroomId String
  student     Student          @relation(fields: [studentId], references: [id])
  classroom   Classroom        @relation(fields: [classroomId], references: [id])

  date        DateTime         @db.Date
  status      AttendanceStatus
  remark      String?

  markedById  String
  markedBy    User             @relation("MarkedByUser", fields: [markedById], references: [id])

  createdAt   DateTime @default(now())

  @@unique([studentId, date])
  @@index([classroomId, date])
  @@index([date, status])
}

// ── Fees ───────────────────────────────────────────────────────────────────

model FeeStructure {
  id          String      @id @default(cuid())
  classroomId String
  classroom   Classroom   @relation(fields: [classroomId], references: [id])
  name        String                 // 'Monthly · 2026', 'Admission Fee'
  amount      Decimal     @db.Decimal(12, 2)
  frequency   String                 // 'monthly' | 'one-time' | 'quarterly'
  active      Boolean     @default(true)

  invoices    Invoice[]

  createdAt DateTime @default(now())

  @@index([classroomId, active])
}

model Invoice {
  id              String        @id @default(cuid())
  invoiceNo       String        @unique         // 'INV-2026-05-0042'
  studentId       String
  feeStructureId  String?
  student         Student       @relation(fields: [studentId], references: [id])
  feeStructure    FeeStructure? @relation(fields: [feeStructureId], references: [id])

  monthYear       String                          // '2026-05' for monthly fees
  amount          Decimal       @db.Decimal(12, 2)
  discount        Decimal       @db.Decimal(12, 2) @default(0)
  total           Decimal       @db.Decimal(12, 2)
  amountPaid      Decimal       @db.Decimal(12, 2) @default(0)
  status          InvoiceStatus @default(ISSUED)
  dueDate         DateTime
  issuedAt        DateTime      @default(now())

  payments        Payment[]
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, monthYear])
  @@index([status, dueDate])
}

model Payment {
  id          String        @id @default(cuid())
  invoiceId   String
  invoice     Invoice       @relation(fields: [invoiceId], references: [id])

  amount      Decimal       @db.Decimal(12, 2)
  method      PaymentMethod
  reference   String?                         // bank ref / wallet txn id
  paidAt      DateTime      @default(now())

  recordedById String
  recordedBy   User         @relation("RecordedByUser", fields: [recordedById], references: [id])

  notes       String?

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([paidAt])
}

// ── Assessments ────────────────────────────────────────────────────────────

model Assessment {
  id           String         @id @default(cuid())
  studentId    String
  student      Student        @relation(fields: [studentId], references: [id])

  kind         AssessmentKind
  term         String?                      // 'Term 1 · 2026'
  subject      String?                      // for PRIMARY_GRADE
  score        Decimal?       @db.Decimal(6, 2)
  scoreMax     Decimal?       @db.Decimal(6, 2)
  grade        String?                      // 'A', 'A+', 'B' (derived)

  // Montessori observation fields — qualitative
  area         String?                      // 'Practical Life', 'Sensorial', 'Language', etc.
  milestone    String?                      // 'Independently pours water without spilling'
  notes        String?

  assessedAt   DateTime       @default(now())
  assessedById String
  assessedBy   User           @relation("AssessedByUser", fields: [assessedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, kind])
  @@index([assessedAt])
}

// ── Homework ───────────────────────────────────────────────────────────────

model Homework {
  id          String   @id @default(cuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id])

  subject     String
  title       String
  description String?
  dueDate     DateTime
  attachmentUrl String?

  postedAt    DateTime @default(now())
  postedById  String                       // userId of the teacher who posted
  postedBy    User     @relation("HomeworkPostedBy", fields: [postedById], references: [id])

  @@index([classroomId, dueDate])
}

// ── Announcements & notifications ──────────────────────────────────────────

model Announcement {
  id            String                @id @default(cuid())
  title         String
  body          String                                          // markdown
  audience      AnnouncementAudience  @default(ALL)
  classroomId   String?                                         // when audience = CLASSROOM
  classroom     Classroom?            @relation("ClassroomAnnouncements", fields: [classroomId], references: [id])
  postedById    String
  postedBy      User                  @relation("PostedByUser", fields: [postedById], references: [id])

  publishAt     DateTime              @default(now())
  expiresAt     DateTime?
  pinned        Boolean               @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([audience, publishAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  kind      NotificationKind
  title     String
  body      String?
  link      String?
  read      Boolean          @default(false)

  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
}

// ── Audit log ──────────────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actor       User?    @relation(fields: [actorId], references: [id])
  action      String                  // 'student.create', 'invoice.update', etc.
  entityType  String
  entityId    String
  diff        Json?
  ip          String?
  userAgent   String?

  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

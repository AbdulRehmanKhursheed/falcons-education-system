# Database — local Postgres via docker-compose
DATABASE_URL="postgresql://falcons:falcons@localhost:5432/falcons_portal?schema=public"

# NextAuth
# Generate with: openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_TRUST_HOST=true
NEXTAUTH_URL=http://localhost:3001

# ── Seed credentials ────────────────────────────────────────────────────
# Used by prisma/seed.ts. In NODE_ENV=production, every variable below MUST
# be set or the seed refuses to run. In dev, missing vars fall back to the
# (policy-compliant) defaults committed in prisma/seed.ts and the seed prints
# a warning.
#
# Each value must satisfy the password policy in lib/password.ts:
#   - at least 10 characters
#   - upper + lower + digit + symbol
#   - not on the common-passwords blocklist
SEED_ADMIN_EMAIL=admin@falconseducationsystem.com
SEED_ADMIN_PASSWORD=
SEED_PRINCIPAL_PASSWORD=
SEED_TEACHER_PASSWORD=
SEED_ACCOUNTS_PASSWORD=
SEED_PARENT_PASSWORD=

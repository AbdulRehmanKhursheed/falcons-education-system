# Database — local Postgres via docker-compose
DATABASE_URL="postgresql://falcons:falcons@localhost:5432/falcons_portal?schema=public"

# NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_TRUST_HOST=true
NEXTAUTH_URL=http://localhost:3001

# Seed admin (used by prisma/seed.ts on first run)
SEED_ADMIN_EMAIL=admin@falconseducationsystem.com
SEED_ADMIN_PASSWORD=change-me-on-first-login
